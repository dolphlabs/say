# Copy to .env for local runs. Read once at startup (zokor.load_config);
# the process environment wins over this file. ZOKOR_PROFILE picks
# .env.<profile> on top (dev by default).
SERVICE_NAME=say
PORT=8080

# Persistence: PostgreSQL (authoritative)
DATABASE_URL=postgres://user:password123@localhost:5432/say_dev?sslmode=disable
DB_POOL_SIZE=10
# PG_TIMEOUT=2s

# Persistence: Redis (holds, session cache, rate limits; never authoritative)
REDIS_URL=redis://localhost:6379
REDIS_POOL_SIZE=8
# REDIS_TIMEOUT=50ms

# Migrations run as the schema owner; the service connects as a member of
# the say_app role, which cannot rewrite the ledger journal (make migrate).
# MIGRATE_DATABASE_URL=postgres://owner:password@localhost:5432/say_dev?sslmode=disable

# Seasons and the ledger
# Season 01 starts here (Mon 12 Oct 2026 00:00 Africa/Lagos); never change it
# once seasons exist.
# SEASON_ANCHOR=2026-10-11T23:00:00Z

# GRANT_WORKERS=4
# GRANT_CHUNK=500
# RECON_EVERY=5m
# Serves Prometheus text at /metrics to this bearer token; unset turns it off.
# METRICS_TOKEN=

# Auth
# HMAC key for one-time codes (and the outbox seal): 32+ random bytes.
OTP_SECRET=change-me-change-me-change-me-change-me-0000
# RESERVED_USERNAMES=say,admin,support,...   (comma-separated; has a default)
# Password hashing pool: keep HASH_WORKERS below the number of cores.
# HASH_WORKERS=2
# HASH_QUEUE=64
# Where the app lives, for redirects after Google sign-in.
APP_URL=http://localhost:3000

# Google sign-in (optional; off until GOOGLE_CLIENT_ID is set)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8080/v1/auth/google/callback
# GOOGLE_TIMEOUT=5s

# Email: console prints codes and is allowed only in the dev/test profiles.
EMAIL_PROVIDER=console
# EMAIL_PROVIDER=sendbyte
# SENDBYTE_API_KEY=
# SENDBYTE_URL=https://api.sendbyte.africa/v1/emails
# EMAIL_TIMEOUT=10s
EMAIL_FROM=say <verify@say.exchange>

# Exchange policy defaults
TRADING_FEE=1
MIN_ORDER_NOTIONAL=2
DISPUTE_WINDOW_SECONDS=1800
TIMEZONE=Africa/Lagos

# Server settings
# LOG_FORMAT=json
# LOG_LEVEL=log
# TRUSTED_PROXIES=10.0.0.0/8      (needed behind a proxy: rate limits key on the client IP)
# TLS_CERT_FILE=
# TLS_KEY_FILE=
