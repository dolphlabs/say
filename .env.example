# Copy to .env for local runs. Read once at startup (zokor.load_config);
# the process environment wins over this file.
SERVICE_NAME=say
PORT=8080

# API keys (for tenant / machine authentication)
API_KEYS=dev:change-me-change-me-change-me-0000

# Authentication secrets (at least 32 bytes each)
COOKIE_KEYS=change-me-change-me-change-me-change-me-0000
JWT_SECRETS=change-me-change-me-change-me-change-me-0000
# JWT_AUDIENCE=
# JWT_ISSUER=
# JWT_LEEWAY=30

# Persistence: PostgreSQL (authoritative)
DATABASE_URL=postgres://user:password123@localhost:5432/say_dev?sslmode=disable
DB_POOL_SIZE=10

# Persistence: Redis (cache, temporary tokens, ephemeral streams)
REDIS_URL=redis://localhost:6379
REDIS_POOL_SIZE=8

# Exchange policy defaults
TRADING_FEE=1
MIN_ORDER_NOTIONAL=2
SEASON_GRANT_AMOUNT=1000
DISPUTE_WINDOW_SECONDS=1800
TIMEZONE=Africa/Lagos

# Server settings
# LOG_FORMAT=json
# LOG_LEVEL=log
# TLS_CERT_FILE=
# TLS_KEY_FILE=
